# Copy to .env for local development. In Docker these come from docker/compose.yml.

# Database (MySQL / MariaDB)
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=shj
NUXT_DB_PASSWORD=
NUXT_DB_DATABASE=shj_web
NUXT_DB_PREFIX=shj_

# Secret for the session cookie, at least 32 characters (e.g. `openssl rand -hex 24`)
NUXT_SESSION_PASSWORD=
# true when served over HTTPS
NUXT_SESSION_COOKIE_SECURE=false

# Folders written to Settings on a fresh install
NUXT_PATHS_TESTER=../tester
NUXT_PATHS_ASSIGNMENTS=../assignments

# true only behind a reverse proxy (client addresses from X-Forwarded-For)
NUXT_TRUST_PROXY=false

# Judge: local runs tester.sh in this process (needs Linux + compilers, no isolation);
# remote hands jobs to the judge container through NUXT_JUDGE_JOBS_DIR
NUXT_JUDGE_MODE=local
NUXT_JUDGE_JOBS_DIR=/data/jobs
NUXT_QUEUE_ENABLED=true

# Backup folder written by the backup service (Docker); empty hides backups
NUXT_BACKUP_DIR=

# Cheat detection (JPlag 6.3 needs Java 25); leave empty to disable
NUXT_CHEAT_JAVA=
NUXT_CHEAT_JPLAG_JAR=
NUXT_CHEAT_WORK_DIR=

# SMTP for password reset and new-account mails
NUXT_MAIL_HOST=
NUXT_MAIL_PORT=465
NUXT_MAIL_SECURE=true
NUXT_MAIL_USER=
NUXT_MAIL_PASS=

# Optional extra login method: ldap or radius
NUXT_AUTH_METHOD=
NUXT_AUTH_LDAP_URL=
NUXT_AUTH_LDAP_ACCOUNT_SUFFIX=
NUXT_AUTH_RADIUS_SERVER=
NUXT_AUTH_RADIUS_SECRET=
